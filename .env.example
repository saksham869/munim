# Optional: let an OpenAI-compatible model draft proposals (off when unset).
# Munim never needs a model to decide; any reply is parsed strictly and still has to pass every rule.
MUNIM_LLM_BASE_URL=https://api.example.com/v1
MUNIM_LLM_API_KEY=replace-me
MUNIM_LLM_MODEL=model-name

# API access. Set both for anything beyond a local demo; with neither set, the API runs open and /health says so.
# The agent token can only create proposals; the owner token can also approve, reject and use the kill switch.
MUNIM_AGENT_TOKEN=replace-with-a-long-random-string
MUNIM_OWNER_TOKEN=replace-with-a-different-long-random-string

# 0 removes the routes that simulate outcomes (they exist only because the demo data is synthetic).
MUNIM_DEMO_ROUTES=1
